# Example Environment Variables for Kumpe3D

# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================================================
# Application Environment
# ============================================================================
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL (recommended)
DATABASE_URL=postgresql://kumpe3d:password@localhost:5432/kumpe3d

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://kumpe3d:password@localhost:3306/kumpe3d

# SQLite (development only)
# DATABASE_URL=sqlite:///./kumpe3d.db

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ============================================================================
# Security Configuration
# ============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200,https://localhost,https://kumpe3d.com
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Frontend Configuration
# ============================================================================
# API URL for frontend to call backend
API_URL=http://localhost:8000

# SSL/TLS Configuration
ENABLE_SSL=true
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem
# Leave empty to auto-generate self-signed certificate

# ============================================================================
# PayPal Integration
# ============================================================================
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com  # sandbox
# PAYPAL_API_URL=https://api-m.paypal.com  # production

# ============================================================================
# Email Configuration (SMTP)
# ============================================================================
SMTP_HOST=smtp.sendpulse.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@kumpe3d.com
SMTP_FROM_NAME=Kumpe3D
SMTP_USE_TLS=true

# ============================================================================
# Pushover Notifications (Admin Alerts)
# ============================================================================
PUSHOVER_API_KEY=your-pushover-api-key
PUSHOVER_USER_KEY=your-pushover-user-key
PUSHOVER_ORDERS_GROUP=your-orders-group-key

# ============================================================================
# Zoho Books Integration
# ============================================================================
ZOHO_WEBHOOK_SECRET=your-zoho-webhook-secret

# ============================================================================
# Shippo Integration
# ============================================================================
SHIPPO_API_KEY=your-shippo-api-key
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret

# ============================================================================
# Tax Calculation
# ============================================================================
# Arkansas sales tax API (if applicable)
SALES_TAX_API_KEY=your-sales-tax-api-key

# ============================================================================
# File Storage
# ============================================================================
# Local file storage path
UPLOAD_DIR=/app/uploads

# Maximum file size (bytes)
MAX_UPLOAD_SIZE=10485760  # 10MB

# Allowed file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_EXPIRE_DAYS=30  # Guest cart expiration

# ============================================================================
# External Image Service
# ============================================================================
# For filament swatch images
IMAGE_SERVICE_URL=https://images.kumpeapps.com

# ============================================================================
# Google Analytics
# ============================================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Sentry (error tracking)
SENTRY_DSN=your-sentry-dsn

# Application Insights
APPINSIGHTS_INSTRUMENTATION_KEY=your-app-insights-key

# ============================================================================
# Docker Configuration
# ============================================================================
# PostgreSQL container settings
POSTGRES_USER=kumpe3d
POSTGRES_PASSWORD=password
POSTGRES_DB=kumpe3d
POSTGRES_PORT=5432

# Backend container settings
BACKEND_PORT=8000

# Frontend container settings
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443

# ============================================================================
# Development Tools
# ============================================================================
# Enable API documentation
ENABLE_DOCS=true

# Enable CORS for all origins (development only)
ENABLE_CORS_ALL=false

# Auto-reload on code changes
RELOAD=true
